{
  "opencollection": "1.0.0",
  "info": {
    "name": "Mem0 API Docs agents exports API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "exports",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Create an export job with schema",
